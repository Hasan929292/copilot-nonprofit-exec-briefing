ks: All Users Policy (all users, Unlimited, 1,000 credits/user/month), Sourcing (Group Procurement, 30,000/month), Finance (20,000), Executive (Leadership, 5,000), Operations (15,000), Sales (Work IQ API, 25,000), Customer Support (5,000), Engineering (Work IQ API, 20,000), Marketing (15,000), IT (Work IQ API, 5,000), Human Resources (10,000), Legal (Copilot Cowork, 15,000), and Procurement (10,000).</span></p></div>","presenterNotes":"<div><p><span style=\"font-family:Segoe UI;\">On the Configuration page, I can set up policies for different groups or individuals to monitor and control consumption. </span></p><p><span style=\"font-family:Segoe UI;\">This allows me to intentionally allocate credits across information work, development, security work and so on. </span></p><p><span style=\"font-family:Segoe UI;font-weight:bold;\">Action</span><span style=\"font-family:Segoe UI;\">: Select </span><span style=\"font-family:Segoe UI;font-weight:bold;\">Sourcing</span><span style=\"font-family:Segoe UI;\">.</span></p></div>","animationDelay":41.66666666666667,"animationType":"Normal","images":[],"shapes":[{"type":"Styled","image":{"path":"69a38d3c-11d8-4baa-8d77-d162c15909b6.webp","imageId":"69a38d3c-11d8-4baa-8d77-d162c15909b6","height":45,"width":1514},"imageVerticalAlign":"Center","imageHorizontalAlign":"Center","imageFit":"fill","isScreenReaderVisible":true,"isAnnotation":false,"isPresenterViewVisible":false,"backgroundColor":"#0000","border":{"left":0.0,"top":0.0,"right":0.0,"bottom":0.0},"borderColor":"#0000","borderRadius":{"topLeft":0.0,"topRight":0.0,"bottomRight":0.0,"bottomLeft":0.0},"foregroundColor":"black","fontSize":16.0,"text":"","textAlignment":"Left","canScroll":false,"headingLevel":"None","horizontalScroll":"hidden","verticalScroll":"hidden","horizontalScrollOffset":0.0,"verticalScrollOffset":0.0,"childrenRelative":false,"lastChildFill":false,"shapeId":"99182217-d162-4dbc-bf16-67a86866c9ce","name":"Hover Image 1","clickAction":"None","hoverAction":"None